platform :ios, '12.1'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # 手动接管 ffmpeg-kit 的 iOS pod 源
  pod 'ffmpeg-kit-ios-full',
      :podspec => 'https://raw.githubusercontent.com/luthviar/ffmpeg-kit-ios-full/main/ffmpeg-kit-ios-full.podspec'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',

        ## permission_handler
        'PERMISSION_EVENTS=1',
        'PERMISSION_REMINDERS=1',
        'PERMISSION_CONTACTS=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_SPEECH_RECOGNIZER=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_MEDIA_LIBRARY=1',
      ]
    end
  end

  resource_script = File.join(
    installer.sandbox.root.to_s,
    'Target Support Files',
    'Pods-Runner',
    'Pods-Runner-resources.sh'
  )

  if File.exist?(resource_script)
    hik_resource_block = <<~'SH'

    # qc_hik_player extra resources copied to app main bundle for Hik playback SDK compatibility
    QC_HIK_RESOURCE_ROOT="${PODS_ROOT}/../.symlinks/plugins/qc_hik_player/ios/ThirdParty/HikiotOpenSDK/Core/lib/EzvizLib"
    install_resource "${QC_HIK_RESOURCE_ROOT}/doc/dependency_EZPlayerSDK.ini"
    install_resource "${QC_HIK_RESOURCE_ROOT}/doc/dependency_EZVideoTalk.ini"
    install_resource "${QC_HIK_RESOURCE_ROOT}/res/iOS/com.hri.hpc.mobile.ios.player.metallib"
    install_resource "${QC_HIK_RESOURCE_ROOT}/res/iOS/ezrtc_media_session_skin_gray.png"
    install_resource "${QC_HIK_RESOURCE_ROOT}/res/iOS/ezrtc_media_session_skin_lookup.png"
    if [[ -d "${QC_HIK_RESOURCE_ROOT}/res/iOS/EZRTCBasicFilter" ]]; then
      install_resource "${QC_HIK_RESOURCE_ROOT}/res/iOS/EZRTCBasicFilter"
      for resource in "${QC_HIK_RESOURCE_ROOT}/res/iOS/EZRTCBasicFilter"/*; do
        install_resource "${resource}"
      done
    fi
    SH

    script_content = File.read(resource_script)
    marker = '# qc_hik_player extra resources copied to app main bundle for Hik playback SDK compatibility'
    script_content.gsub!(/^\n# qc_hik_player extra resources copied to app main bundle for Hik playback SDK compatibility.*?^fi\n/m, '')
    anchor = 'if [[ "$CONFIGURATION" == "Debug" ]]; then'
    if script_content.include?(anchor)
      script_content.sub!(anchor, "#{hik_resource_block}\n#{anchor}")
      File.write(resource_script, script_content)
    end
  end
end
